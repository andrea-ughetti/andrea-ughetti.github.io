@unpublished{ughetti_delegation,
  bibtex_show = {true},
  title       = {Human Capital in the Technological Era: a Theory of Expertise and Delegation},
  author      = {Ughetti, Andrea},
  year        = {2026},
  note        = {Work in progress},
  abstract    = {Rising labor-market inequality is increasingly linked to how production tasks are divided between human and machine capital, yet most existing frameworks treat that division as a fixed technological fact rather than an individual choice. I develop a model in which a worker allocates effort each period between her own expertise and an increasingly capable machine, with comparative advantage between the two encoded by fixed technology weights over a two-dimensional space of task complexity and non-routineness. Delegating tasks to the machine raises current output but slows the accumulation of human capital, since learning occurs only through active human production — creating a tension between short-run productivity and long-run expertise. I show that the optimal delegation choice is governed by comparative rather than absolute advantage, and that a myopic decision-maker who ignores this future cost of delegation systematically over-automates relative to the forward-looking optimum. The framework combines task-based automation models, cognitive-effort production, and learning-by-doing into a single individual-level optimization problem, offering a microfoundation for how technological change reshapes both the returns to human capital and the incentive to keep investing in it.},
  selected    = {true}
}

@unpublished{ughetti_galliera_ghisolfi_panebianco_labor_markets,
  bibtex_show = {true},
  title       = {Technology, Productivity, and Redistribution: Uncovering the Micro Drivers of Macro Trends in Technology-Rich Labor Markets},
  author      = {Ughetti, Andrea and Galliera, A. and Ghisolfi, S. and Panebianco, F.},
  year        = {2026},
  note        = {Work in progress},
  abstract    = { Understanding what drives labor market trends is of primary importance, as most people derive the vast majority of their income from labor. While advancing technology enables capital to perform increasingly complex tasks, humans remain crucial to production, and their compensation varies across many dimensions such as technology regimes, preferences, perceived contribution, and team composition. We ask whether technology alters managers’ desired degree of redistribution and whether it changes the efficiency cost of redistribution by dampening worker incentives. To test these mechanisms, we design a theory-guided experiment. In the model, two workers use a complementary technology to produce output, facing effort costs shaped by their time endowment, while a manager with a stake in production sets wage compression before effort is exerted.  Technology affects redistribution through the scale of output gaps, the attribution of output between human and machine, and the intensity of the manager’s inequality aversion. On the worker side, the model predicts that wage compression always weakens incentives: its relative cost is independent of technology, but its absolute cost grows with technological progress. We implement a variant of the spectator game to empirically isolate these channels. To break the circularity between effort choice and desired redistribution, we split it into a worker game and a manager game, randomizing technology, time endowments and wage compression. Workers do a real effort task with or without the help of an LLM. Managers choose the wage rule for teams of people with different time constraints but the same access to technology, and their pay depends on the output of the team they are matched with. They then evaluate the ex-post production of two workers as pure spectators, with nothing at stake. Comparing these two choices separates what managers consider fair from how much profit they are willing to give up for it. The design allows us to distinguish whether technology changes managers’ perceptions of inequality, their attribution of output to workers, or their willingness to pay for redistribution. On the workers’ side, it will be mostly interesting to see the optimal response of workers to the wage compression level, and thus estimate the efficiency lost under different regimes.},
  selected    = {true}
}
